# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=
KID_SESSION_SECRET=
# Used by `supabase db push` (migrations)
POSTGRES_URL_NON_POOLING=

# Gemini draft quizzes. Server-only. Leave the key empty to hide the AI button.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-4-hydrogen,gemini-3.5-flash-lite,gemini-3.6-flash

# Media storage driver ('supabase' by default)
MEDIA_STORAGE_DRIVER=supabase
